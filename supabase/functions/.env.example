# Copia este archivo fuera de Git y carga los valores como secretos de Supabase Edge Functions.
# Nunca expongas estas claves en VITE_* ni dentro del renderer de Electron.

# Firebase UTET: lecturas institucionales existentes.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Firebase Admin: necesario para guardar y leer la configuración IA desde Firestore.
# Usa una cuenta de servicio con permisos mínimos sobre Firestore.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Proveedores de similitud externa.
OPENALEX_API_KEY=
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
BRAVE_SEARCH_API_KEY=
CROSSREF_MAILTO=

# Clave maestra independiente para cifrar las API keys de los modelos IA antes de guardarlas en Firebase.
# Debe ser larga, aleatoria y distinta de SUPABASE_SERVICE_ROLE_KEY.
AI_CREDENTIALS_MASTER_KEY=

# La revisión global envía contenido académico minimizado a proveedores IA externos.
# Debe habilitarse deliberadamente después de validar la política institucional.
AI_EXTERNAL_REVIEW_ENABLED=false

# Compatibilidad temporal con instalaciones anteriores. El motor nuevo toma la configuración desde Firebase.
ARTICLE_REVIEW_API_URL=
ARTICLE_REVIEW_API_KEY=
ARTICLE_REVIEW_MODEL=
